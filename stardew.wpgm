import wollok.game.*
import ciclo.*
import configuracion.*
import personaje.*
import objetos.*

program StardewGame {
    game.title("Stardew Magic")
    game.cellSize(48)
    game.height(20)
    game.width(20)
    game.addVisual(fondo)

    principal.inventario().add(
        new Recursos(nombre = "semillaGirasol", cantidad = 4))
    configuracion.iniciar()
}